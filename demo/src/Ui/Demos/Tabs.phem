<?phem

namespace App\Ui\Demos;

use Phem\Attribute\Page;
use Phem\Node;

use function App\Ui\{DemoPage, Example, Examples, Hero};
use function Phem\Ui\Base\Examples\{TabsAnimatedPanelsDemo, TabsHeroDemo, TabsHiddenUntilFoundDemo};

#[Page('/components/tabs')]
function TabsPage(): Node
{
    return (
        <DemoPage slug="tabs">
            <Hero source="TabsHeroDemo">
                <TabsHeroDemo />
            </Hero>
            <Examples>
                <Example title="Animated panels" source="TabsAnimatedPanelsDemo">
                    <Example.description>
                        <p>Animate panels as they activate using the <code>data-starting-style</code> and <code>data-ending-style</code> attributes.</p>
                        <p>The <code>data-activation-direction</code> attribute indicates which direction the newly active tab is relative to the previously active one, letting panels slide in from the correct side.</p>
                    </Example.description>
                    <TabsAnimatedPanelsDemo />
                </Example>
                <Example title="Hidden until found" source="TabsHiddenUntilFoundDemo">
                    <Example.description>
                        <p>The <code>hiddenUntilFound</code> prop hides the panels that are not selected with <a href="https://developer.mozilla.org/en-US/docs/Web/HTML/Reference/Global_attributes/hidden" className="underline"><code>hidden="until-found"</code></a>, so the browser can search their contents. A match in a hidden panel selects its tab. It can be set on each <code>TabsPanel</code>, or once on <code>Tabs</code> to apply to all panels.</p>
                        <p>To try it, press <kbd>Ctrl</kbd>+<kbd>F</kbd> (<kbd>Cmd</kbd>+<kbd>F</kbd> on macOS) and search for “deadlines”—the browser selects the tab of the panel that has the match. Older browsers that don’t support <code>hidden="until-found"</code> keep the panels hidden, and find-in-page skips over the contents.</p>
                    </Example.description>
                    <TabsHiddenUntilFoundDemo />
                </Example>
            </Examples>
        </DemoPage>
    );
}
